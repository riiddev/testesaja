# ==============================================================================
# SINAUENGLISH V2 — Environment Variables Example
# Copy this file to .env for local development. DO NOT commit .env to Git!
# ==============================================================================

# 1. Neon PostgreSQL Connection String (Branch: development, Pooled)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Better Auth Configuration
# Secret key for encrypting tokens & sessions (generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=your_random_32_character_secret_key_here
# Base URL for auth endpoints (http://localhost:5173 for local dev; automatic in Vercel preview)
BETTER_AUTH_URL=http://localhost:5173

# 3. Development / Mock Mode Flags
# Only active in development if explicitly set to true. Production builds IGNORE this flag.
VITE_ENABLE_MOCK=false

# 4. Legacy Google Apps Script Web App URL (DO NOT DELETE — preserved until verification complete)
VITE_API_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
