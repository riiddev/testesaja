# ==============================================================================
# SINAUENGLISH V2 — Environment Variables Example
# Copy this file to .env for local development. Never commit .env.
# ==============================================================================
#
# IMPORTANT:
# - DATABASE_URL is the POOLED Neon connection used by the app at runtime.
# - DATABASE_URL_UNPOOLED is the DIRECT connection used for Drizzle migrations
#   and database backup/restore. Keep it local; do not put it in Vercel Functions.
# - Replace every placeholder with values from the Neon development branch only.
# - Never paste connection strings or secrets into GitHub, chat, or logs.

# 1. Neon PostgreSQL — runtime (Pooled; hostname contains "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Neon PostgreSQL — migrations and backups (Direct; no "-pooler")
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Better Auth (used when Phase 3 authentication is implemented)
# Generate a unique secret locally:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=REPLACE_WITH_A_UNIQUE_32_BYTE_RANDOM_SECRET
BETTER_AUTH_URL=http://localhost:5173

# 4. Development / Mock Mode
# Mock mode must remain false for any Preview or Production build.
VITE_ENABLE_MOCK=false

# 5. Legacy Google Apps Script (keep until Neon cutover is verified)
# Preserve the current project environment value locally; do not use this
# placeholder as a real endpoint.
VITE_API_URL=https://script.google.com/macros/s/REPLACE_WITH_LEGACY_DEPLOYMENT_ID/exec
